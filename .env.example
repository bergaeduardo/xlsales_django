# .env.example — plantilla de variables de entorno
# Copiar a .env: cp .env.example .env
# NUNCA commitear el .env real (está en .gitignore)

# ============================================================
# Django
# ============================================================
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False

# Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_50_CHAR_STRING

# Hostnames/IPs que Django va a aceptar (coma-separados, sin espacios)
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes confiables para CSRF (Django 4+, deben incluir esquema)
CSRF_TRUSTED_ORIGINS=http://localhost:8000

SECURE_HSTS_SECONDS=0

# ============================================================
# Base de datos DEFAULT (PostgreSQL) — auth, sesiones, PerfilUsuario
# Mismo servidor que usuarios_wms (XL-AI-TEST)
# ============================================================
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME=usuarios_xlsales
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432

# ============================================================
# Base XLSALES (SQL Server) — datos existentes del sistema (managed=False)
# ============================================================
XLSALES_DB_NAME=dbXLSales
XLSALES_DB_USER=sa
XLSALES_DB_PASSWORD=CHANGE_ME
XLSALES_DB_HOST=XL-AI-TEST
XLSALES_DB_PORT=1433

# ============================================================
# Base TANGO (SQL Server readonly) — ERP externo (validación NC)
# ============================================================
TANGO_DB_NAME=LAKER_SA
TANGO_DB_USER=sa
TANGO_DB_PASSWORD=CHANGE_ME
# Producción: XL-TANGO ; testing/dev: XL-AI-TEST
TANGO_DB_HOST=XL-AI-TEST
TANGO_DB_PORT=1433

# ============================================================
# Email (Gmail SMTP heredado de XLSales .NET)
# ============================================================
# En dev usar console backend:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_ME@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=XLSales <CHANGE_ME@gmail.com>

# ============================================================
# Waitress (leídos por deploy/waitress_server.py)
# ============================================================
WAITRESS_HOST=127.0.0.1
WAITRESS_PORT=8001
WAITRESS_THREADS=8
WAITRESS_URL_SCHEME=https

# ============================================================
# Seguridad (production.py fuerza a True)
# ============================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ============================================================
# Sentry (opcional)
# ============================================================
SENTRY_DSN=
